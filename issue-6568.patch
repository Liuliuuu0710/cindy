+  const h = harness();
+  h.failNextCommits(1);
+  const gate = h.gate();
+  h.edit({ name: 'Unsaved' });
+  const saving = h.autosave.flush();
+  h.edit({ name: h.baseline.name });
+  gate.release();
+  await saving;
+  expect(h.autosave.isDirty()).toBe(false);
+  expect(h.statuses).toEqual(['saving', 'idle']);
+  expect(h.commits).toHaveLength(1);
+});
